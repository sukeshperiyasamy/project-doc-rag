# Server Network Configuration (strictly bound to localhost)
HOST=127.0.0.1
PORT=9621
WEBUI_TITLE='Research Knowledge Base'
WEBUI_DESCRIPTION='Personal Graph-Based RAG System'

# Storage Paths
WORKING_DIR=C:\Research-Knowledge-Base\rag_storage
INPUT_DIR=C:\Research-Knowledge-Base\inputs
LOG_DIR=C:\Research-Knowledge-Base\logs
PROMPT_DIR=C:\Research-Knowledge-Base\config

# Storage Implementations (100% Local file-based, no external databases)
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# LLM Configuration (Local Ollama or API)
# For Local Ollama:
LLM_BINDING="ollama"
LLM_MODEL="qwen2.5:3b"
LLM_BINDING_HOST="http://127.0.0.1:11434"

# Embedding Configuration (Local FastEmbed OpenAI-compatible server on port 9622)
EMBEDDING_BINDING="openai"
EMBEDDING_BINDING_HOST="http://127.0.0.1:9622/v1"
EMBEDDING_MODEL="bge-small-en-v1.5"
EMBEDDING_DIM="384"
EMBEDDING_TOKEN_LIMIT=2048
EMBEDDING_SEND_DIM="false"
EMBEDDING_BINDING_API_KEY="local_fastembed_key"

# Document Processing & Semantic Chunking
LIGHTRAG_PARSER=docx:native-teP,*:legacy-R
ENABLE_CONTENT_HEADINGS=true
ENTITY_EXTRACTION_USE_JSON=true
ENTITY_TYPE_PROMPT_FILE=entity_type_prompt.yml

# Query Context Length
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000

# Concurrency & Rate Limiting
MAX_ASYNC=1
MAX_PARALLEL_INSERT=1
LLM_MODEL_MAX_ASYNC=1
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_BATCH_NUM="64"
EMBEDDING_TIMEOUT="60"
LLM_TIMEOUT="120"
